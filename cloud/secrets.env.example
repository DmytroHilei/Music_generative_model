# Copy to cloud/secrets.env (git-ignored) on the instance and fill in. Never commit the real file.
# Hugging Face token with WRITE access (huggingface.co -> Settings -> Access Tokens -> "Write"):
# downloads the private data repo and pushes/pulls the checkpoint repos.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# wandb API key (wandb.ai/authorize), for the live dashboard. Leave empty to train without wandb (--no-wandb in preflight
# and EXTRA_ARGS="--wandb_log=False" for launch).
WANDB_API_KEY=
# 1 = stop (not destroy) the vast.ai instance after the final checkpoint push, so finished runs don't bill GPU time.
AUTO_STOP=1
